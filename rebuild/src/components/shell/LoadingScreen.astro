---
/* Phase 1B: the "infinito" wordmark draws itself in on load (legacy §6.1
 * SVG draw-on intro) instead of snapping, then the overlay fades to reveal
 * the page.
 *
 * Wordmark geometry is the Infinito logotype outline, lifted as a visual
 * asset from Final_Files/index.html (viewBox 500x500, cropped here to the
 * glyph band).
 *
 * The draw is **CSS-first** (stroke-dashoffset outline + fill-opacity fade,
 * `pathLength="100"` normalises the dash math per glyph). No GSAP: this is an
 * above-the-fold overlay, and gating it on the JS runtime regresses LCP and
 * violates the above-the-fold rule (AGENTS.md, #43/#48). `ANIMATION_AUDIT.md`
 * §6.1 lists CSS dasharray as the sanctioned alternative to DrawSVG here. The
 * animation only runs under `html.has-anim` (set pre-paint when JS + motion
 * are on), so reduced-motion / no-JS show the solid wordmark immediately. The
 * script just holds the overlay until the draw finishes AND the window has
 * loaded, then fades out. */

// I N F I N I T O — one path per glyph, in draw order (left → right).
const WORDMARK: string[] = [
  "M 26.401 207.984 L 26.401 292.016 L 9.087 292.016 L 9.087 207.984 L 26.401 207.984 Z",
  "M 111.599 207.984 L 111.599 292.016 L 94.285 292.016 L 60.58 236.726 L 60.58 292.016 L 43.266 292.016 L 43.266 207.984 L 60.58 207.984 L 94.343 263.39 L 94.343 207.984 L 111.599 207.984 Z",
  "M 178.098 243.709 L 178.098 257.676 L 144.855 257.676 L 144.855 292.016 L 127.541 292.016 L 127.541 207.984 L 182.254 207.984 L 182.254 222.009 L 144.855 222.009 L 144.855 243.709 L 178.098 243.709 Z",
  "M 211.527 207.984 L 211.527 292.016 L 194.213 292.016 L 194.213 207.984 L 211.527 207.984 Z",
  "M 296.726 207.984 L 296.726 292.016 L 279.412 292.016 L 245.707 236.726 L 245.707 292.016 L 228.393 292.016 L 228.393 207.984 L 245.707 207.984 L 279.469 263.39 L 279.469 207.984 L 296.726 207.984 Z",
  "M 331.078 207.984 L 331.078 292.016 L 313.764 292.016 L 313.764 207.984 L 331.078 207.984 Z",
  "M 411.198 207.984 L 411.198 222.009 L 385.457 222.009 L 385.457 292.016 L 368.143 292.016 L 368.143 222.009 L 342.749 222.009 L 342.749 207.984 L 411.198 207.984 Z",
  "M 490.2 248.107 L 490.2 251.813 L 490.2 251.813 Q 490.2 264.072 485.867 273.309 L 485.867 273.309 L 485.867 273.309 Q 481.533 282.546 473.465 287.563 L 473.465 287.563 L 473.465 287.563 Q 465.398 292.581 454.963 292.581 L 454.963 292.581 L 454.963 292.581 Q 444.643 292.581 436.547 287.62 L 436.547 287.62 L 436.547 287.62 Q 428.451 282.66 424.003 273.451 L 424.003 273.451 L 424.003 273.451 Q 419.556 264.243 419.499 252.27 L 419.499 252.27 L 419.499 248.164 L 419.499 248.164 Q 419.499 235.906 423.918 226.583 L 423.918 226.583 L 423.918 226.583 Q 428.336 217.261 436.404 212.272 L 436.404 212.272 L 436.404 212.272 Q 444.472 207.283 454.849 207.283 L 454.849 207.283 L 454.849 207.283 Q 465.227 207.283 473.294 212.272 L 473.294 212.272 L 473.294 212.272 Q 481.362 217.261 485.781 226.583 L 485.781 226.583 L 485.781 226.583 Q 490.2 235.906 490.2 248.107 L 490.2 248.107 Z M 472.867 252.099 L 472.867 248.05 L 472.867 248.05 Q 472.867 234.993 468.191 228.208 L 468.191 228.208 L 468.191 228.208 Q 463.516 221.423 454.849 221.423 L 454.849 221.423 L 454.849 221.423 Q 446.24 221.423 441.564 228.123 L 441.564 228.123 L 441.564 228.123 Q 436.889 234.822 436.832 247.765 L 436.832 247.765 L 436.832 251.813 L 436.832 251.813 Q 436.832 264.528 441.507 271.541 L 441.507 271.541 L 441.507 271.541 Q 446.183 278.554 454.963 278.554 L 454.963 278.554 L 454.963 278.554 Q 463.573 278.554 468.191 271.798 L 468.191 271.798 L 468.191 271.798 Q 472.81 265.041 472.867 252.099 L 472.867 252.099 Z",
