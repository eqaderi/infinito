---

<div
  id="loading-screen"
  class="fixed inset-0 z-50 grid place-items-center bg-paper transition-opacity duration-500 ease-out"
  data-loading-screen
>
  <div class="flex flex-col items-center gap-7">
    <svg
      class="h-14 w-28 animate-pulse text-ink"
      viewBox="0 0 187.3 93.7"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        d="M93.9,46.4c9.3,9.5,13.8,17.9,23.5,17.9s17.5-7.8,17.5-17.5s-7.8-17.6-17.5-17.5c-9.7,0.1-13.3,7.2-22.1,17.1c-8.9,8.8-15.7,17.9-25.4,17.9s-17.5-7.8-17.5-17.5s7.8-17.5,17.5-17.5S86.2,38.6,93.9,46.4z"
      ></path>
    </svg>
    <svg
      class="h-8 w-auto text-ink"
      viewBox="0 195 500 110"
      role="img"
      aria-label="infinito"
      data-loader-word
    >
      {
        WORDMARK.map((d, i) => (
          <path
            d={d}
            pathLength="100"
            vector-effect="non-scaling-stroke"
            class="fill-ink stroke-ink [stroke-width:1.5px]"
            style={`--i:${i}`}
          />
        ))
      }
    </svg>
  </div>
</div>

<style>
  /* CSS-first draw: only under html.has-anim (JS + motion, set pre-paint in
     <head>) does each glyph draw its outline then fade its fill in. The `both`
     fill-mode holds the from-state through the per-glyph stagger delay, so
     there is no flash. Reduced-motion / no-JS never add has-anim → the solid
     default (fill-opacity 1, no dash) shows immediately. */
  @keyframes loader-glyph {
    from {
      stroke-dashoffset: 100;
      fill-opacity: 0;
    }
    55% {
      stroke-dashoffset: 0;
      fill-opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
  }

  html.has-anim #loading-screen [data-loader-word] path {
    stroke-dasharray: 100;
    animation: loader-glyph 1.6s cubic-bezier(0.33, 1, 0.68, 1) both;
    animation-delay: calc(var(--i, 0) * 0.12s);
  }
</style>

<script>
  const screen = document.querySelector<HTMLElement>('[data-loading-screen]');
  if (screen) {
    const hide = () => {
      screen.style.opacity = '0';
      screen.style.pointerEvents = 'none';
      window.setTimeout(() => {
        screen.style.display = 'none';
      }, 600);
    };

    const loaded = () =>
      document.readyState === 'complete'
        ? Promise.resolve()
        : new Promise<void>((r) =>
            window.addEventListener('load', () => r(), { once: true }),
          );

    // The CSS draw runs only under has-anim. When it does, hold the overlay
    // until the last (most-delayed) glyph finishes; otherwise there is no draw
    // to wait for. A timeout guards against a missing animationend.
    const animated = document.documentElement.classList.contains('has-anim');
    const paths = screen.querySelectorAll<SVGPathElement>(
      '[data-loader-word] path',
    );

    const drawn = () => {
      if (!animated || paths.length === 0) return Promise.resolve();
      const last = paths[paths.length - 1];
      return new Promise<void>((resolve) => {
        const finish = () => resolve();
        last.addEventListener('animationend', finish, { once: true });
        window.setTimeout(finish, 3000);
      });
    };

    Promise.all([loaded(), drawn()]).then(() => window.setTimeout(hide, 200));
  }
</script>
